# Store values in the cloud secret manager. Use the TLS settings required by the PostgreSQL provider.
DATABASE_URL=
MIGRATION_DATABASE_URL=
INGEST_DATABASE_URL=
PUBLIC_URL=https://cs.example.com
PORT=8080

# Register https://cs.example.com/oidc/callback as the web app redirect.
OIDC_ISSUER=https://company.okta.example.com/oauth2/default
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# The MCP access token audience must be exactly https://cs.example.com/mcp.
# MCP_ISSUER defaults to OIDC_ISSUER. The selected signed claim must match the web ID token sub.
MCP_ISSUER=
MCP_USER_ID_CLAIM=uid

SALESFORCE_BASE_URL=https://company--cs.sandbox.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v66.0
PILOT_ACCOUNT_IDS=

# Optional. The local demo uses its own simulator. A real handoff requires an explicit live configuration.
GONG_MODE=disabled
GONG_API_BASE_URL=https://api.gong.io
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
GONG_PILOT_ACCOUNT_ID=
GONG_PILOT_CONTACT_ID=
GONG_PILOT_USER_ID=
GONG_MANUAL_FLOW_ID=
GONG_FLOW_OWNER_EMAIL=
GONG_MANUAL_FLOW_CONFIRMED=false
# JSON object containing Gong-confirmed content override fields for the one manual step.
# Set the subject and HTML body values to "$approved_subject" and "$approved_body_html".
GONG_COPY_OVERRIDE_JSON=
